# --- Server ---
PORT=3000

# --- Payments ---
# The wallet that RECEIVES USDC payments. Must be a real address you control.
PAYMENT_WALLET=0xYourBaseWalletAddressHere

# Network to charge on. Use base-sepolia (testnet) until everything works,
# then switch to "base" for real mainnet USDC.
X402_NETWORK=base-sepolia

# --- Coinbase Developer Platform (CDP) ---
# Required so the facilitator can verify + settle payments on mainnet.
# Get these free at https://portal.cdp.coinbase.com/projects
# Not required for base-sepolia testing against the public x402.org facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Optional: GoPlus Security API key (higher rate limits) ---
# Leave blank to use GoPlus's free unauthenticated tier.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
